{
  "name": "financial-platform",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=@workspace/financial-platform && esbuild server.impl.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:express --external:cors --external:pg --external:drizzle-orm --external:bcryptjs --external:pino --external:pino-http --external:vite",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'No lint errors'"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.23.1",
    "@workspace/api-server": "*",
    "@workspace/db": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
